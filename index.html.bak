<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Jonas Benjamin Friedli</title>
  <style>
    /* Base */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Segoe UI', Tahoma, sans-serif; color: #fff; background: #0e0f1a; }

    /* Grid background */
    .grid-bg { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: -1;
      background-image: linear-gradient(#282a3a 1px, transparent 1px), linear-gradient(90deg, #282a3a 1px, transparent 1px);
      background-size: 40px 40px;
    }
    .grid-bg::after { content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 50%;
      background: linear-gradient(to bottom, rgba(14,15,26,0) 0%, rgba(14,15,26,1) 100%);
    }

    /* Hero */
    .hero { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 0 20px; position: relative; }
    .hero h1 { font-size: clamp(2rem, 5vw, 4rem); background: linear-gradient(90deg, #4e8cff, #b76cff); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .hero p { font-size: clamp(0.875rem, 2vw, 1.25rem); color: #ccc; margin-top: .5rem; }
    .socials { margin-top: 1.5rem; display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }
    .socials a img { width: 48px; height: 48px; background: rgba(255,255,255,0.1); padding: 8px; border-radius: 50%; transition: background 0.3s, transform .2s; }
    .socials a img:hover { background: rgba(255,255,255,0.2); transform: translateY(-2px); }
    .scroll-down { position: absolute; bottom: 5%; font-size: 1.25rem; color: #777; animation: float 3s ease-in-out infinite; }
    @keyframes float { 0%,100%{transform:translateY(0);} 50%{transform:translateY(8px);} }

    /* Content */
    .content { padding: 80px 20px; max-width: 1100px; margin: auto; }
    h2 { color: #fff; margin-bottom: 1rem; font-size: clamp(1.25rem, 3.5vw, 2rem); text-align: center; }

    /* Table base */
    table { width: 100%; border-collapse: collapse; background: #1c1d2a; border-radius: 12px; overflow: hidden; }
    th, td { padding: 12px 16px; text-align: left; border-bottom: 1px solid #2a2b3a; }
    th { background: #2a2b3a; cursor: pointer; position: sticky; top: 0; z-index: 1; }
    tr:hover td { background: rgba(255,255,255,0.05); }
    a.reference { color: #8b5cf6; text-decoration: none; font-weight: 500; }
    a.reference:hover { text-decoration: underline; }

    /* Scrollable wrappers */
    .table-card { background: #1c1d2a; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.35); border: 1px solid #2a2b3a; }
    .table-header { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid #2a2b3a; background: linear-gradient(0deg, #1c1d2a, #222335); border-top-left-radius: 12px; border-top-right-radius: 12px; }
    .table-title { font-weight: 600; letter-spacing: .3px; }
    .table-meta { color: #aaa; font-size: .95rem; }
    .table-wrap { max-height: 60vh; overflow: auto; scrollbar-width: thin; scrollbar-color: #444 transparent; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; }
    .table-wrap::-webkit-scrollbar { height: 10px; width: 10px; }
    .table-wrap::-webkit-scrollbar-thumb { background: #444; border-radius: 10px; }

    /* Mobile friendliness */
    @media (max-width: 768px) {
      .socials a img { width: 40px; height: 40px; padding: 6px; }
      .content { padding: 40px 12px; }
      th, td { padding: 10px 12px; font-size: .95rem; }
      .table-wrap { max-height: 55vh; }
    }

    /* For very small phones */
    @media (max-width: 480px) {
      .hero h1 { font-size: 2rem; }
      .hero p  { font-size: 0.9rem; }
      .scroll-down { font-size: 1.1rem; }
      th, td { padding: 8px 10px; font-size: 0.875rem; }
      /* Allow horizontal scroll if columns overflow on tiny screens */
      .table-wrap { overflow: auto; }
      .table-inner { min-width: 720px; }
    }
  </style>
</head>
<body>
